# ============================================================
# VOLCANO PLOT MEJORADO — DEP Olink
# Modelo 3: Treatment:Time interaction
# Sin olink_volcano_plot — construido desde cero con ggplot2
# ============================================================
library(dplyr)
library(ggplot2)
library(ggrepel)

# ============================================================
# BLOQUE 1 — Post-hoc para obtener estimate (dirección)
# ============================================================

posthoc_M3 <- olink_lmer_posthoc(
  df                      = npx_model,
  olinkid_list            = NULL,
  variable                = c("Treatment", "Time"),
  random                  = "Subject",
  covariates              = "Site",
  effect                  = "Treatment",
  post_hoc_padjust_method = "BH",
  verbose                 = FALSE
)

cat("Columnas post-hoc:\n"); print(colnames(posthoc_M3))
cat("\nPrimeras filas:\n"); print(head(posthoc_M3, 4))

# ============================================================
# BLOQUE 2 — Preparar datos del volcano
# ============================================================

# El post-hoc da una fila por comparación por proteína
# Nos quedamos solo con Treated - Untreated (la comparación de interés)
volcano_df <- posthoc_M3 %>%
  filter(str_detect(contrast, "Treated") & str_detect(contrast, "Untreated")) %>%
  filter(!is.na(estimate), !is.na(Adjusted_pval)) %>%
  mutate(
    log10p = -log10(Adjusted_pval),
    
    # Clasificación up / down / NS
    Categoria = case_when(
      Adjusted_pval < 0.05 & estimate > 0 ~ "Positive",
      Adjusted_pval < 0.05 & estimate < 0 ~ "Negative",
      TRUE                                    ~ "Insignificant"
    ),
    Categoria = factor(Categoria,
                       levels = c("Positive", "Negative", "Insignificant")),
    
    # Label solo para significativos
    Label   = ifelse(Adjusted_pval < 0.05, Assay, NA_character_),
    pt_size = ifelse(Adjusted_pval < 0.05, 2.8, 1.8)
  )

# Conteos
n_pos <- sum(volcano_df$Categoria == "Positive",      na.rm = TRUE)
n_neg <- sum(volcano_df$Categoria == "Negative",      na.rm = TRUE)
n_ns  <- sum(volcano_df$Categoria == "Insignificant", na.rm = TRUE)

cat("\n═══════════════════════════════════\n")
cat("  VOLCANO — Treatment (post-hoc)\n")
cat("═══════════════════════════════════\n")
cat("Positive (Treated↑):", n_pos, "\n")
cat("Negative (Treated↓):", n_neg, "\n")
cat("Insignificant:      ", n_ns,  "\n")

# Límites simétricos eje X
x_abs <- max(abs(volcano_df$estimate), na.rm = TRUE) * 1.15
y_max <- max(volcano_df$log10p,         na.rm = TRUE) * 1.12
fdr_y <- -log10(0.05)

# ============================================================
# BLOQUE 3 — Tema blanco estilo publicación
# ============================================================

tema_blanco <- theme_classic(base_size = 13) +
  theme(
    plot.background   = element_rect(fill = "white", color = NA),
    panel.background  = element_rect(fill = "white", color = NA),
    panel.grid.major  = element_line(color = "#F0F0F0", linewidth = 0.4),
    panel.grid.minor  = element_blank(),
    axis.line         = element_line(color = "#333333", linewidth = 0.7),
    axis.ticks        = element_line(color = "#333333", linewidth = 0.5),
    axis.text         = element_text(color = "#333333", size = 11),
    axis.title        = element_text(color = "#111111", size = 12, face = "bold"),
    plot.title        = element_text(color = "#111111", size = 15, face = "bold",
                                     margin = margin(b = 4)),
    plot.subtitle     = element_text(color = "#666666", size = 9.5,
                                     margin = margin(b = 14)),
    plot.caption      = element_text(color = "#999999", size = 8,
                                     hjust = 0, margin = margin(t = 10)),
    plot.margin       = margin(20, 24, 14, 20),
    legend.background = element_rect(fill = "white", color = "#CCCCCC",
                                     linewidth = 0.4),
    legend.key        = element_rect(fill = NA),
    legend.text       = element_text(color = "#333333", size = 10),
    legend.title      = element_blank(),
    legend.position   = c(0.88, 0.80),
    legend.margin     = margin(8, 12, 8, 12)
  )

# ============================================================
# BLOQUE 4 — Plot
# ============================================================

p_volcano <- ggplot(volcano_df,
                    aes(x = estimate, y = log10p,
                        color = Categoria, size = Categoria)) +
  
  # ── Líneas de referencia
  geom_hline(yintercept = fdr_y,
             linetype = "dashed", color = "#AAAAAA", linewidth = 0.6) +
  geom_vline(xintercept = 0,
             linetype = "solid",  color = "#DDDDDD", linewidth = 0.6) +
  
  # ── Puntos NS primero (fondo)
  geom_point(data = filter(volcano_df, Categoria == "Insignificant"),
             alpha = 0.55, shape = 16) +
  
  # ── Puntos significativos encima
  geom_point(data = filter(volcano_df, Categoria != "Insignificant"),
             alpha = 0.88, shape = 16) +
  
  # ── Labels con ggrepel
  geom_text_repel(
    aes(label = Label),
    color         = "#111111",
    size          = 2.9,
    fontface      = "bold",
    family        = "mono",
    box.padding   = 0.5,
    point.padding = 0.25,
    segment.color = "#AAAAAA",
    segment.size  = 0.35,
    max.overlaps  = 30,
    na.rm         = TRUE
  ) +
  
  # ── Anotación n en esquinas
  annotate("text",
           x = -x_abs * 0.92, y = y_max * 0.97,
           label = paste0("Negative\nn = ", n_neg),
           color = "#2779B5", size = 3.2, hjust = 0, fontface = "bold") +
  annotate("text",
           x =  x_abs * 0.92, y = y_max * 0.97,
           label = paste0("Positive\nn = ", n_pos),
           color = "#E07B30", size = 3.2, hjust = 1, fontface = "bold") +
  
  # ── Label línea FDR
  annotate("text",
           x = x_abs * 0.92, y = fdr_y + y_max * 0.022,
           label = "FDR = 0.05",
           color = "#AAAAAA", size = 2.6, hjust = 1, family = "mono") +
  
  # ── Escalas
  scale_color_manual(
    values = c(
      "Positive"     = "#E07B30",
      "Negative"     = "#2779B5",
      "Insignificant" = "#AAAAAA"
    )
  ) +
  scale_size_manual(
    values = c("Positive" = 2.8, "Negative" = 2.8, "Insignificant" = 1.8),
    guide  = "none"
  ) +
  scale_x_continuous(
    limits = c(-x_abs, x_abs),
    labels = function(x) sprintf("%+.0f", x)
  ) +
  scale_y_continuous(
    limits = c(0, y_max),
    expand = expansion(mult = c(0, 0.05))
  ) +
  
  labs(
    title    = "Expresión Diferencial de Proteínas",
    subtitle = paste0(
      "Modelo: NPX ~ Treatment × Time + Site + (1|Subject)   ·   post-hoc: Treated vs Untreated   ·   ",
      n_pos + n_neg, " significativas (FDR < 0.05)"
    ),
    x       = expression(Fold~change~(log[2])),
    y       = expression(-log[10](P~value)),
    color   = NULL,
    caption = "OlinkAnalyze · lmerTest · emmeans · BH correction"
  ) +
  
  tema_blanco +
  coord_cartesian(clip = "off")

