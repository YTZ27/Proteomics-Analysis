    pct_outlier = round(n_outlier / n_proteinas * 100, 2),
    median_NPX  = round(median(NPX, na.rm = TRUE), 3),
    .groups     = "drop"
  ) %>%
  dplyr::arrange(desc(pct_outlier)) %>%
  dplyr::mutate(
    es_outlier = ifelse(pct_outlier > UMBRAL_PCT, "Outlier", "Normal"),
    es_outlier = factor(es_outlier, levels = c("Normal", "Outlier"))
  )

