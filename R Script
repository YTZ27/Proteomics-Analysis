npx_outlier_flagged <- npx_qc %>%
  dplyr::filter(!str_detect(SampleID, "CONTROL")) %>%
  dplyr::mutate(
    is_outlier_protein = olink_median_iqr_outlier(
      df        = .,
      quant_col = "NPX",
      group     = c("OlinkID", "Time"),  # separado por timepoint
      iqr_sd    = IQR_K
    )
  )

