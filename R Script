  dplyr::filter(str_detect(SampleID, "CONTROL")) %>%
  dplyr::filter(NPX > LOD) %>%
  dplyr::group_by(OlinkID) %>%
  dplyr::mutate(CV = t96_cv(NPX)) %>%
  dplyr::ungroup() %>%
  dplyr::distinct(OlinkID, CV)

