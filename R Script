# Función interna: calcula PCA por panel y devuelve coordenadas listas para graficar
hacer_pca_panel <- function(datos, nombre_panel) {
  
  df <- datos %>%
    dplyr::filter(Panel == nombre_panel) %>%
    dplyr::select(SampleID, Type, Assay, NPX) %>%
    tidyr::pivot_wider(names_from = Assay, values_from = NPX)
  
  # Imputar NAs con la mediana por proteína (más robusto que la media para NPX)
  mat <- df %>%
    dplyr::select(-SampleID, -Type) %>%
    dplyr::mutate(across(everything(), ~ifelse(is.na(.), median(., na.rm = TRUE), .)))
  
  pca <- prcomp(mat, center = TRUE, scale. = TRUE)
  
  var1 <- round(summary(pca)$importance[2, 1] * 100, 2)
  var2 <- round(summary(pca)$importance[2, 2] * 100, 2)
  
  data.frame(
    SampleID = df$SampleID,
    Type     = df$Type,
    PC1      = pca$x[, 1],
    PC2      = pca$x[, 2],
    Panel    = nombre_panel,
    PC1_lab  = paste0("PC1 (", var1, "%)"),
    PC2_lab  = paste0("PC2 (", var2, "%)")
  )
}

