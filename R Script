# =============================================================================
# 9. EXPRESIÓN DIFERENCIAL
# =============================================================================

npx_model <- npx_qc %>%
  dplyr::filter(!str_detect(SampleID, "CONTROL")) %>%
  dplyr::filter(!is.na(Treatment), !is.na(Subject), !is.na(Site), !is.na(Time)) %>%
  dplyr::mutate(
    Treatment = factor(Treatment, levels = c("Untreated", "Treated")),  # Untreated = referencia
    Time      = factor(Time,      levels = c("Baseline", "Week.6", "Week.12")),
    Site      = factor(Site)
  )

cat("\nN sujetos en modelo:", n_distinct(npx_model$Subject), "\n")
cat("N proteínas en modelo:", n_distinct(npx_model$OlinkID), "\n")

# --- Modelo 1: t-test simple ---
# Fórmula implícita: NPX ~ Treatment
# Propósito: baseline rápido para comparar con modelos más complejos.
# Limitación: ignora la estructura longitudinal y el efecto de sitio.
# NO es el modelo recomendado para este diseño; se incluye solo como referencia.
Modelo_1 <- olink_ttest(df = npx_model, variable = "Treatment")

cat("\nModelo 1 (t-test, solo referencia):\n")
cat("Proteínas significativas (FDR<0.05):", sum(Modelo_1$Adjusted_pval < 0.05, na.rm = TRUE), "\n")


# --- Modelo 2: LMM ajustado por sitio ---
# Fórmula: NPX ~ Treatment + Site + (1|Subject)
# Subject como efecto aleatorio: captura la correlación entre medidas repetidas del mismo sujeto.
# Site como covariable fija: controla diferencias sistemáticas entre centros de reclutamiento.
# Aplica cuando el interés principal es el efecto de Treatment sin modelar su cambio en el tiempo.
Modelo_2 <- olink_lmer(
  df         = npx_model,
  variable   = "Treatment",
  random     = "Subject",
  covariates = "Site"
)

cat("\nModelo 2 (LMM + Site, efecto Treatment):\n")
cat("Términos en el modelo:", paste(unique(Modelo_2$term), collapse = ", "), "\n")
cat("Proteínas significativas (FDR<0.05):", sum(Modelo_2$Adjusted_pval < 0.05, na.rm = TRUE), "\n")

# Verificar warnings de convergencia Modelo 2
n_fallos_m2 <- Modelo_2 %>% dplyr::filter(is.na(statistic)) %>% nrow()
cat("Modelo 2 — proteínas sin ajuste (statistic = NA):", n_fallos_m2, "\n")



# --- Modelo 3: LMM longitudinal completo (RECOMENDADO) ---
# Fórmula: NPX ~ Treatment * Time + Site + (1|Subject)
#   - Treatment: ¿difieren los grupos en promedio a lo largo de todos los timepoints?
#   - Time: ¿cambian las proteínas con el tiempo independientemente del tratamiento?
#   - Treatment:Time: ¿el efecto del tratamiento difiere según el momento de la visita?
#     Esta interacción es biológicamente la más interesante.
#   - (1|Subject): cada sujeto tiene su propio intercepto aleatorio.
Modelo_3 <- olink_lmer(
  df         = npx_model,
  variable   = c("Treatment", "Time"),  # OlinkAnalyze infiere la interacción automáticamente
  random     = "Subject",
  covariates = "Site"
)

cat("\nModelo 3 (LMM longitudinal completo — RECOMENDADO):\n")
cat("Proteínas significativas por término:\n")
Modelo_3 %>%
  dplyr::filter(Adjusted_pval < 0.05) %>%
  dplyr::count(term, name = "n_significativas") %>%
  print()

# Verificar warnings de convergencia
n_fallos_m3 <- Modelo_3 %>% dplyr::filter(is.na(statistic)) %>% nrow()
cat("Modelo 3 — proteínas sin ajuste (statistic = NA):", n_fallos_m3, "\n")



# --- Extraer proteínas significativas por modelo y término ---
sig_M2_treatment <- Modelo_2 %>%
  dplyr::filter(Adjusted_pval < 0.05, term == "Treatment") %>%
  dplyr::arrange(Adjusted_pval)

sig_M3_treatment <- Modelo_3 %>%
  dplyr::filter(Adjusted_pval < 0.05, term == "Treatment") %>%
  dplyr::arrange(Adjusted_pval)

sig_M3_interaccion <- Modelo_3 %>%
  dplyr::filter(Adjusted_pval < 0.05, str_detect(term, "Treatment:Time")) %>%
  dplyr::arrange(Adjusted_pval)


